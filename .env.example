# Copy to .env.local and fill in. Never commit .env.local.
# See docs/deployment.md for XAMPP and production MySQL setup.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bukidbasket
DB_USER=root
DB_PASS=

# Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=change-me-to-a-random-64-char-hex-string
APP_ENV=development
